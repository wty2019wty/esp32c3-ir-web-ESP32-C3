menu "IR Web Tool Configuration"

    config IR_TOOL_IR_RX_GPIO
        int "IR receiver GPIO (VS1838B OUT)"
        default 4
        help
            VS1838B demodulated baseband output, idle high.

    config IR_TOOL_IR_TX_GPIO
        int "IR transmitter GPIO (needs transistor driver)"
        default 3
        help
            Carrier-modulated output. Drive an IR LED via a transistor.

    config IR_TOOL_CARRIER_FREQ_HZ
        int "Default IR carrier frequency (Hz)"
        default 38000
        help
            Carrier frequency used for IR transmission. Can be changed at
            runtime from the web UI (persisted in NVS). Common values:
            38000 (most consumer electronics), 36000, 40000.

    config IR_TOOL_CARRIER_DUTY
        int "IR carrier duty cycle (percent)"
        default 33
        help
            Duty cycle of the carrier signal in percent. 25-50%, 33% is common.

    config IR_TOOL_WIFI_AP_SSID
        string "SoftAP SSID"
        default "ESP32C3-IR"

    config IR_TOOL_WIFI_AP_PASSWORD
        string "SoftAP password (empty = open network)"
        default ""

    config IR_TOOL_WIFI_AP_CHANNEL
        int "SoftAP channel"
        default 1

    config IR_TOOL_WIFI_AP_MAX_CONN
        int "SoftAP max connections"
        default 4

    config IR_TOOL_WIFI_STA_SSID
        string "Station SSID (empty = skip station)"
        default ""

    config IR_TOOL_WIFI_STA_PASSWORD
        string "Station password"
        default ""

    config IR_TOOL_WIFI_STA_TIMEOUT_MS
        int "Station connection timeout (ms), then fall back to SoftAP"
        default 10000

    config IR_TOOL_WIFI_STA_TX_POWER_DBM
        int "Max station TX power (dBm)"
        default 15
        range 8 20
        help
            Cap the station TX power. Some ESP32-C3 boards fail open-auth
            (WIFI_REASON_AUTH_EXPIRE, reason 2) at the default 20 dBm while
            SoftAP works fine; 15 dBm connects reliably on such boards.

    config IR_TOOL_HTTP_PORT
        int "HTTP server port"
        default 80

    config IR_TOOL_HOSTNAME
        string "DHCP hostname (shown in router client list)"
        default "ir-web"

    config IR_TOOL_HISTORY_DEPTH
        int "In-memory frame history depth"
        default 8
        help
            In-memory history ring. Each slot holds one full frame including
            the raw duration array (IR_TOOL_MAX_RX_SEGS entries, 4 bytes each),
            so RAM usage = depth x frame size. With 1024 segments one frame is
            about 4.2 KB; the default 8 slots keep static RAM around 34 KB.

    config IR_TOOL_MAX_RX_SEGS
        int "Max alternating IR segments per captured frame"
        default 1024
        range 192 2048
        help
            Number of alternating on/off duration segments a single IR frame
            can hold (air-conditioner protocols often exceed 300 segments).
            The RMT RX ping-pong mode accumulates long frames in a RAM buffer,
            so the limit is memory, not the 192-symbol RMT hardware. Each
            segment costs 4 bytes inside every history frame slot.

    config IR_TOOL_MAX_RAW_SYMBOLS
        int "Max RMT symbols per transmission (raw data replay)"
        default 2048

endmenu
